/**
 * AssetVerification.compact — SilentLedger v2
 *
 * Privacy-Preserving Asset Ownership Verification
 *
 * Upgraded to v0.31.1 patterns:
 * - Witness-derived UserPublicKey (replaces bypassable ownPublicKey())
 * - Proper disclose() on all witness-derived values
 * - Uint<128> for amounts (widened from Uint<64>)
 * - Sealed admin key (was unsealed)
 * - Witness-based ZK proof verification (replaces placeholder)
 * - Domain-separated key derivation
 * - Owner-revocation via witness identity (was unauthenticated)
 *
 * Patterns: midnight-expert FungibleToken, midnight-modules commitment-nullifier
 * Compiler: compactc v0.31.1
 */

pragma language_version >= 0.16 && <= 0.23;

import CompactStandardLibrary;

// ============================================================================
// DATA STRUCTURES
// ============================================================================

export struct UserSecretKey {
  bytes: Bytes<32>;
}

export struct UserPublicKey {
  bytes: Bytes<32>;
}

export struct AdminPublicKey {
  bytes: Bytes<32>;
}

struct OwnershipProof {
  ownerHash: Bytes<32>;
  assetId: Bytes<32>;
  verified: Boolean;
  timestamp: Uint<64>;
  proofHash: Bytes<32>;
}

export struct VerificationResult {
  stillValid: Boolean;
  expiryTimestamp: Uint<64>;
}

struct CompositeKeyInput {
  ownerHash: Bytes<32>;
  assetId: Bytes<32>;
}

struct ProofHashInput {
  ownerHash: Bytes<32>;
  assetId: Bytes<32>;
  minAmount: Uint<128>;
  timestamp: Uint<64>;
}

// ============================================================================
// LEDGER STATE
// ============================================================================

export ledger ownershipProofs: Map<Bytes<32>, OwnershipProof>;
export ledger usedProofs: Set<Bytes<32>>;

// Admin key — witness-derived (was ownPublicKey(), which is bypassable)
sealed ledger adminKey: Bytes<32>;

// ============================================================================
// WITNESSES
// ============================================================================

witness getUserSecret(): UserSecretKey;
witness getAdminSecret(): UserSecretKey;

// ZK proof verification — computed off-chain by the prover
witness verifyOwnershipProof(
  ownerHash: Bytes<32>,
  assetId: Bytes<32>,
  minAmount: Uint<128>
): Boolean;

// ============================================================================
// CONSTRUCTOR
// ============================================================================

constructor() {
  const adminSecret = getAdminSecret();
  const adminPub = deriveAdminPublicKey(adminSecret);
  adminKey = disclose(adminPub.bytes);
}

// ============================================================================
// HELPER CIRCUITS
// ============================================================================

pure circuit deriveUserPublicKey(sk: UserSecretKey): UserPublicKey {
  return UserPublicKey {
    bytes: persistentHash<Vector<2, Bytes<32>>>([
      pad(32, "silentledger:user:pk:v2"),
      sk.bytes
    ])
  };
}

pure circuit deriveAdminPublicKey(sk: UserSecretKey): AdminPublicKey {
  return AdminPublicKey {
    bytes: persistentHash<Vector<2, Bytes<32>>>([
      pad(32, "silentledger:admin:pk:v2"),
      sk.bytes
    ])
  };
}

pure circuit isKeyZero(key: UserPublicKey): Boolean {
  return key == default<UserPublicKey>;
}

circuit compositeKey(ownerHash: Bytes<32>, assetId: Bytes<32>): Bytes<32> {
  return persistentHash<CompositeKeyInput>(CompositeKeyInput {
    ownerHash: ownerHash,
    assetId: assetId
  });
}

// ============================================================================
// CIRCUITS
// ============================================================================

/**
 * Verify ownership of an asset.
 * The ZK proof is verified off-chain by the prover (via witness).
 * The prover proves they own at least minAmount of assetId without
 * revealing the actual balance.
 */
export circuit verifyOwnership(
  ownerHash: Bytes<32>,
  assetId: Bytes<32>,
  minAmount: Uint<128>,
  currentTime: Uint<64>
): Bytes<32> {
  // Verify the ZK ownership proof via witness
  const proofValid = verifyOwnershipProof(ownerHash, assetId, minAmount);
  assert(disclose(proofValid), "Invalid ownership proof");

  // Create deterministic proof hash
  const proofHash = persistentHash<ProofHashInput>(ProofHashInput {
    ownerHash: ownerHash,
    assetId: assetId,
    minAmount: minAmount,
    timestamp: currentTime
  });

  // Prevent replay
  assert(disclose(!usedProofs.member(proofHash)), "Proof already used");
  usedProofs.insert(disclose(proofHash));

  // Build and store the ownership proof record
  const proof = OwnershipProof {
    ownerHash: ownerHash,
    assetId: assetId,
    verified: true,
    timestamp: currentTime,
    proofHash: proofHash
  };

  const key = compositeKey(ownerHash, assetId);
  ownershipProofs.insert(disclose(key), disclose(proof));

  return disclose(proofHash);
}

/**
 * Check if an ownership verification is still valid.
 * Validity expires 86400 seconds (24 hours) after verification.
 *
 * @param ownerHash - Hash of the owner identity
 * @param assetId - Asset identifier
 * @param expectedProofHash - The proof hash to match
 * @param currentTime - Current timestamp
 * @returns VerificationResult with validity and expiry timestamp
 */
export circuit checkVerification(
  ownerHash: Bytes<32>,
  assetId: Bytes<32>,
  expectedProofHash: Bytes<32>,
  currentTime: Uint<64>
): VerificationResult {
  const key = compositeKey(ownerHash, assetId);

  // Check if any verification exists for this owner+asset
  if (!ownershipProofs.member(disclose(key))) {
    return VerificationResult { stillValid: false, expiryTimestamp: 0 };
  }

  const proof = ownershipProofs.lookup(disclose(key));

  // Check verification is active and proof hash matches
  if (!proof.verified) {
    return VerificationResult { stillValid: false, expiryTimestamp: 0 };
  }
  if (proof.proofHash != expectedProofHash) {
    return VerificationResult { stillValid: false, expiryTimestamp: 0 };
  }

  // Check 24-hour expiry (86400 seconds)
  const expiryTimestamp = (proof.timestamp + 86400) as Uint<64>;
  if (currentTime > expiryTimestamp) {
    return VerificationResult { stillValid: false, expiryTimestamp: expiryTimestamp };
  }

  return VerificationResult { stillValid: true, expiryTimestamp: expiryTimestamp };
}

/**
 * Revoke an ownership verification.
 * Only the original owner can revoke (proven via witness-derived key).
 */
export circuit revokeVerification(
  ownerHash: Bytes<32>,
  assetId: Bytes<32>
): [] {
  // Verify caller identity via witness
  const sk = getUserSecret();
  const caller = deriveUserPublicKey(sk);
  assert(disclose(!isKeyZero(caller)), "Invalid user key");

  // Verify the ownerHash matches the caller's derived key
  assert(disclose(caller.bytes == ownerHash), "Not the verification owner");

  const key = compositeKey(ownerHash, assetId);
  assert(ownershipProofs.member(disclose(key)), "No active verification found");

  const proof = ownershipProofs.lookup(disclose(key));
  assert(proof.verified, "Verification already revoked");

  const revokedProof = OwnershipProof {
    ownerHash: proof.ownerHash,
    assetId: proof.assetId,
    verified: false,
    timestamp: proof.timestamp,
    proofHash: proof.proofHash
  };
  ownershipProofs.insert(disclose(key), disclose(revokedProof));
}
