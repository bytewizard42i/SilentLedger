/**
 * AssetVerification.compact
 * SilentLedger - Privacy-Preserving Asset Ownership Verification
 *
 * Verifies asset ownership using zero-knowledge proofs without revealing
 * balances. Designed to disincentivize front-running and short selling.
 *
 * Patterns: Based on official bboard (midnightntwrk/example-bboard)
 * and KYCzAnchor (bytewizard42i/KYCz_us_app) reference contracts.
 *
 * Key design change from original: Nested Maps are not supported in
 * Compact, so we flatten the (owner, assetId) pair into a composite
 * key via persistentHash.
 *
 * Compiler: compactc v0.29.0
 */

pragma language_version >= 0.16 && <= 0.21;

import CompactStandardLibrary;

// ============================================================================
// DATA STRUCTURES
// ============================================================================

struct OwnershipProof {
  ownerHash: Bytes<32>;     // Hash of owner identity (privacy-preserving)
  assetId: Bytes<32>;       // Asset identifier
  verified: Boolean;        // Verification status
  timestamp: Uint<64>;      // When verification occurred
  proofHash: Bytes<32>;     // Hash of the ZK proof (verification ID)
}

struct VerificationResult {
  stillValid: Boolean;
  expiryTimestamp: Uint<64>;
}

// Structs for deterministic hashing (persistentHash requires typed inputs)
struct CompositeKeyInput {
  ownerHash: Bytes<32>;
  assetId: Bytes<32>;
}

struct ProofHashInput {
  ownerHash: Bytes<32>;
  assetId: Bytes<32>;
  minAmount: Uint<64>;
  timestamp: Uint<64>;
}

// ============================================================================
// LEDGER STATE
// ============================================================================

// Flat map keyed by composite hash of (owner, assetId)
export ledger ownershipProofs: Map<Bytes<32>, OwnershipProof>;

// Track used proofs to prevent replay
ledger usedProofs: Set<Bytes<32>>;

// Admin key for contract management (set at deploy time)
sealed ledger adminKey: ZswapCoinPublicKey;

// ============================================================================
// CONSTRUCTOR
// ============================================================================

constructor() {
  adminKey = ownPublicKey();
}

// ============================================================================
// HELPER CIRCUITS
// ============================================================================

/**
 * Derive a flat composite key from (owner, assetId) pair.
 * Replaces the nested Map<Address, Map<Bytes<32>, ...>> pattern.
 */
circuit compositeKey(ownerHash: Bytes<32>, assetId: Bytes<32>): Bytes<32> {
  return persistentHash<CompositeKeyInput>(CompositeKeyInput {
    ownerHash: ownerHash,
    assetId: assetId
  });
}

/**
 * Placeholder proof validation.
 * In production, this would verify a real ZK proof via witnesses.
 */
circuit validateProof(
  ownerHash: Bytes<32>,
  assetId: Bytes<32>,
  minAmount: Uint<64>,
  zkProof: Bytes<32>
): Boolean {
  // TODO: Replace with real ZK proof verification via witnesses
  // For now, proof is valid if it is not all zeros
  return zkProof != pad(32, "");
}

// ============================================================================
// CIRCUITS
// ============================================================================

/**
 * Verify ownership of an asset.
 * The ZK proof proves that the caller owns at least minAmount of assetId
 * without revealing the actual balance.
 *
 * @param ownerHash - Hash of the owner's identity (Bytes<32>)
 * @param assetId - Asset identifier
 * @param minAmount - Minimum amount claimed (not revealed to verifiers)
 * @param zkProof - ZK proof of ownership (Bytes<32> commitment)
 * @param currentTime - Current timestamp
 * @returns proofHash serving as verification ID
 */
export circuit verifyOwnership(
  ownerHash: Bytes<32>,
  assetId: Bytes<32>,
  minAmount: Uint<64>,
  zkProof: Bytes<32>,
  currentTime: Uint<64>
): Bytes<32> {
  // Validate the ownership proof
  assert(
    validateProof(ownerHash, assetId, minAmount, zkProof),
    "Invalid ownership proof"
  );

  // Create a deterministic proof hash as the verification ID
  const proofHash = persistentHash<ProofHashInput>(ProofHashInput {
    ownerHash: ownerHash,
    assetId: assetId,
    minAmount: minAmount,
    timestamp: currentTime
  });

  // Ensure this proof hasn't been used before (prevent replay)
  assert(!usedProofs.member(disclose(proofHash)), "Proof already used");
  usedProofs.insert(disclose(proofHash));

  // Build the ownership proof record
  const proof = OwnershipProof {
    ownerHash: ownerHash,
    assetId: assetId,
    verified: true,
    timestamp: currentTime,
    proofHash: proofHash
  };

  // Store under composite key (flattened from nested map)
  const key = compositeKey(ownerHash, assetId);
  ownershipProofs.insert(disclose(key), disclose(proof));

  return disclose(proofHash);
}

/**
 * Check if an ownership verification is still valid.
 * Validity expires 86400 seconds (24 hours) after verification.
 *
 * @param ownerHash - Hash of the owner identity
 * @param assetId - Asset identifier
 * @param expectedProofHash - The proof hash to match
 * @param currentTime - Current timestamp
 * @returns VerificationResult with validity and expiry timestamp
 */
export circuit checkVerification(
  ownerHash: Bytes<32>,
  assetId: Bytes<32>,
  expectedProofHash: Bytes<32>,
  currentTime: Uint<64>
): VerificationResult {
  const key = compositeKey(ownerHash, assetId);

  // Check if any verification exists for this owner+asset
  if (!ownershipProofs.member(disclose(key))) {
    return VerificationResult { stillValid: false, expiryTimestamp: 0 };
  }

  const proof = ownershipProofs.lookup(disclose(key));

  // Check verification is active and proof hash matches
  if (!proof.verified) {
    return VerificationResult { stillValid: false, expiryTimestamp: 0 };
  }
  if (proof.proofHash != expectedProofHash) {
    return VerificationResult { stillValid: false, expiryTimestamp: 0 };
  }

  // Check 24-hour expiry (86400 seconds)
  const expiryTimestamp = (proof.timestamp + 86400) as Uint<64>;
  if (currentTime > expiryTimestamp) {
    return VerificationResult { stillValid: false, expiryTimestamp: expiryTimestamp };
  }

  return VerificationResult { stillValid: true, expiryTimestamp: expiryTimestamp };
}

/**
 * Revoke an ownership verification.
 * Only the original owner can revoke their own verification.
 *
 * @param ownerHash - Hash of the owner identity
 * @param assetId - Asset to revoke verification for
 */
export circuit revokeVerification(
  ownerHash: Bytes<32>,
  assetId: Bytes<32>
): [] {
  const key = compositeKey(ownerHash, assetId);

  // Ensure the verification exists
  assert(ownershipProofs.member(disclose(key)), "No active verification found");

  const proof = ownershipProofs.lookup(disclose(key));
  assert(proof.verified, "Verification already revoked");

  // Create revoked copy (structs are immutable — must build a new one)
  const revokedProof = OwnershipProof {
    ownerHash: proof.ownerHash,
    assetId: proof.assetId,
    verified: false,
    timestamp: proof.timestamp,
    proofHash: proof.proofHash
  };
  ownershipProofs.insert(disclose(key), disclose(revokedProof));
}
