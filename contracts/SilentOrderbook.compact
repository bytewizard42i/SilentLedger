/**
 * SilentOrderbook.compact — SilentLedger v2
 *
 * Privacy-Preserving Orderbook using obfuscated order commitments.
 *
 * Upgraded to v0.31.1 patterns:
 * - Witness-derived UserPublicKey (replaces bypassable ownPublicKey())
 * - Proper disclose() on all witness-derived values
 * - Uint<128> for amounts (widened from Uint<64>)
 * - Sealed admin key (was unsealed ZswapCoinPublicKey)
 * - Domain-separated key derivation
 * - Cancel via witness identity verification (was witness-based but unauthenticated)
 *
 * Patterns: midnight-expert FungibleToken, midnight-modules commitment-nullifier
 * Compiler: compactc v0.31.1
 */

pragma language_version >= 0.16 && <= 0.23;

import CompactStandardLibrary;

// ============================================================================
// DATA STRUCTURES
// ============================================================================

export enum DexState { Active, Paused }
export enum OrderStatus { Open, Matched, Cancelled }

export struct UserSecretKey {
  bytes: Bytes<32>;
}

export struct UserPublicKey {
  bytes: Bytes<32>;
}

export struct AdminPublicKey {
  bytes: Bytes<32>;
}

struct OrderCommit {
  commitment: Bytes<32>;
  ownerHash: Bytes<32>;
  timestamp: Uint<64>;
  status: OrderStatus;
}

struct OrderCommitInput {
  amount: Uint<128>;
  assetId: Bytes<32>;
  isSell: Boolean;
  nonce: Bytes<32>;
}

// ============================================================================
// LEDGER STATE
// ============================================================================

export ledger dexState: DexState;
export ledger lastBatchRoot: Bytes<32>;
export ledger totalOrders: Counter;

ledger orders: Map<Bytes<32>, OrderCommit>;

// Admin key — witness-derived (was ownPublicKey())
sealed ledger adminKey: Bytes<32>;

// ============================================================================
// WITNESSES
// ============================================================================

witness getUserSecret(): UserSecretKey;
witness getAdminSecret(): UserSecretKey;
witness localOrderData(): OrderCommitInput;

// ============================================================================
// HELPER CIRCUITS
// ============================================================================

pure circuit deriveUserPublicKey(sk: UserSecretKey): UserPublicKey {
  return UserPublicKey {
    bytes: persistentHash<Vector<2, Bytes<32>>>([
      pad(32, "silentledger:orderbook:user:pk:v2"),
      sk.bytes
    ])
  };
}

pure circuit deriveAdminPublicKey(sk: UserSecretKey): AdminPublicKey {
  return AdminPublicKey {
    bytes: persistentHash<Vector<2, Bytes<32>>>([
      pad(32, "silentledger:orderbook:admin:pk:v2"),
      sk.bytes
    ])
  };
}

circuit computeCommitment(data: OrderCommitInput): Bytes<32> {
  return persistentHash<OrderCommitInput>(data);
}

// ============================================================================
// CONSTRUCTOR
// ============================================================================

constructor() {
  dexState = DexState.Active;
  lastBatchRoot = pad(32, "");
  const adminSecret = getAdminSecret();
  const adminPub = deriveAdminPublicKey(adminSecret);
  adminKey = disclose(adminPub.bytes);
}

// ============================================================================
// CIRCUITS
// ============================================================================

export circuit addOrder(
  commitment: Bytes<32>,
  ownerHash: Bytes<32>,
  timestamp: Uint<64>
): [] {
  assert(disclose(dexState == DexState.Active), "DEX is paused");
  assert(disclose(!orders.member(commitment)), "Order commitment already exists");

  const newOrder = OrderCommit {
    commitment: commitment,
    ownerHash: ownerHash,
    timestamp: timestamp,
    status: OrderStatus.Open
  };
  orders.insert(disclose(commitment), disclose(newOrder));
  totalOrders.increment(1);
}

export circuit cancelOrder(commitment: Bytes<32>): [] {
  assert(disclose(dexState == DexState.Active), "DEX is paused");
  assert(disclose(orders.member(commitment)), "Order not found");

  const order = orders.lookup(disclose(commitment));
  assert(disclose(order.status == OrderStatus.Open), "Order is not open");

  // Verify ownership: prover supplies private order data via witness,
  // we recompute the commitment and check it matches
  const data = localOrderData();
  const recomputed = computeCommitment(data);
  assert(disclose(recomputed == order.commitment), "Not the order owner");

  const cancelledOrder = OrderCommit {
    commitment: order.commitment,
    ownerHash: order.ownerHash,
    timestamp: order.timestamp,
    status: OrderStatus.Cancelled
  };
  orders.insert(disclose(commitment), disclose(cancelledOrder));
}

export circuit matchOrder(
  buyCommitment: Bytes<32>,
  sellCommitment: Bytes<32>,
  newBatchRoot: Bytes<32>
): [] {
  assert(disclose(dexState == DexState.Active), "DEX is paused");

  assert(disclose(orders.member(buyCommitment)), "Buy order not found");
  assert(disclose(orders.member(sellCommitment)), "Sell order not found");

  const buyOrder = orders.lookup(disclose(buyCommitment));
  const sellOrder = orders.lookup(disclose(sellCommitment));

  assert(disclose(buyOrder.status == OrderStatus.Open), "Buy order is not open");
  assert(disclose(sellOrder.status == OrderStatus.Open), "Sell order is not open");

  const matchedBuy = OrderCommit {
    commitment: buyOrder.commitment,
    ownerHash: buyOrder.ownerHash,
    timestamp: buyOrder.timestamp,
    status: OrderStatus.Matched
  };
  const matchedSell = OrderCommit {
    commitment: sellOrder.commitment,
    ownerHash: sellOrder.ownerHash,
    timestamp: sellOrder.timestamp,
    status: OrderStatus.Matched
  };

  orders.insert(disclose(buyCommitment), disclose(matchedBuy));
  orders.insert(disclose(sellCommitment), disclose(matchedSell));

  lastBatchRoot = disclose(newBatchRoot);
}

export circuit setDexState(newState: DexState): [] {
  const adminSecret = getAdminSecret();
  const adminPub = deriveAdminPublicKey(adminSecret);
  assert(disclose(adminPub.bytes == adminKey), "Only admin can change DEX state");
  dexState = disclose(newState);
}
