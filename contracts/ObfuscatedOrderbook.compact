/**
 * ObfuscatedOrderbook.compact
 * SilentLedger - Privacy-Preserving Orderbook with Ownership Verification
 *
 * Implements a privacy-preserving orderbook that requires asset ownership
 * verification before sell orders can be placed, preventing short selling.
 *
 * Key design changes from original:
 * - No cross-contract imports (Compact doesn't support import-from)
 * - Verification is done by storing verification IDs and checking on-chain
 * - List<> replaced with Map<> (Compact has no List type)
 * - for/while loops replaced with per-order circuit calls
 * - Address replaced with Bytes<32> (owner hash)
 * - Uint<256> replaced with Uint<64> (max Compact width is 248)
 * - Tuple returns replaced with named structs
 * - Struct mutation replaced with new struct construction
 *
 * Patterns: Based on official bboard and KYCzAnchor references.
 * Compiler: compactc v0.29.0
 */

pragma language_version >= 0.16 && <= 0.23;

import CompactStandardLibrary;

// ============================================================================
// DATA STRUCTURES
// ============================================================================

export enum OrderType { Buy, Sell }
export enum OrderStatus { Open, Filled, Cancelled }

struct Order {
  orderId: Bytes<32>;        // Unique order ID
  traderHash: Bytes<32>;     // Hash of the trader identity (privacy-preserving)
  orderType: OrderType;      // Buy or Sell
  assetId: Bytes<32>;        // Asset identifier
  price: Uint<64>;           // Price per unit
  amount: Uint<64>;          // Total order amount
  filled: Uint<64>;          // Amount filled so far
  status: OrderStatus;       // Current order status
  timestamp: Uint<64>;       // Order creation timestamp
  verificationId: Bytes<32>; // Asset verification ID (required for sell orders)
}

struct OrderInfo {
  orderId: Bytes<32>;
  orderType: OrderType;
  assetId: Bytes<32>;
  price: Uint<64>;
  amount: Uint<64>;
  filled: Uint<64>;
  status: OrderStatus;
  timestamp: Uint<64>;
}

// Struct for deterministic order ID generation
struct OrderIdInput {
  traderHash: Bytes<32>;
  assetId: Bytes<32>;
  price: Uint<64>;
  amount: Uint<64>;
  timestamp: Uint<64>;
}

// ============================================================================
// LEDGER STATE
// ============================================================================

// All orders keyed by orderId
ledger orders: Map<Bytes<32>, Order>;

// Track which sell verifications have been used (prevent reuse)
ledger usedVerifications: Set<Bytes<32>>;

// Admin key (set at deploy time)
sealed ledger adminKey: ZswapCoinPublicKey;

// Asset verification contract address (for reference only — verification
// is checked by the caller providing a valid verificationId that was
// previously generated by AssetVerification.compact)
export ledger verificationContractAddr: Bytes<32>;

export ledger totalOrders: Counter;

// ============================================================================
// CONSTRUCTOR
// ============================================================================

constructor() {
  adminKey = ownPublicKey();
  verificationContractAddr = pad(32, "");
}

// ============================================================================
// CIRCUITS
// ============================================================================

/**
 * Set the asset verification contract address (admin only).
 *
 * @param contractAddr - Address of the deployed AssetVerification contract
 */
export circuit setVerificationContract(contractAddr: Bytes<32>): [] {
  assert(ownPublicKey() == adminKey, "Only admin can set verification contract");
  verificationContractAddr = disclose(contractAddr);
}

/**
 * Place a new order.
 *
 * For sell orders, the caller must provide a valid verificationId that was
 * previously obtained from AssetVerification.verifyOwnership(). This
 * prevents short selling — you must prove you own the asset before selling.
 *
 * @param traderHash - Hash of trader identity
 * @param assetId - Asset identifier
 * @param orderType - Buy or Sell
 * @param price - Price per unit
 * @param amount - Total order amount
 * @param verificationId - Required for sell orders (from AssetVerification)
 * @param currentTime - Current timestamp
 * @returns The generated orderId
 */
export circuit placeOrder(
  traderHash: Bytes<32>,
  assetId: Bytes<32>,
  orderType: OrderType,
  price: Uint<64>,
  amount: Uint<64>,
  verificationId: Bytes<32>,
  currentTime: Uint<64>
): Bytes<32> {
  assert(price > 0, "Price must be positive");
  assert(amount > 0, "Amount must be positive");

  // For sell orders, verify the ownership verification ID is valid and unused
  if (disclose(orderType) == OrderType.Sell) {
    // The verificationId must be a non-zero hash (obtained from AssetVerification)
    assert(verificationId != pad(32, ""), "Sell orders require asset verification");
    assert(
      !usedVerifications.member(disclose(verificationId)),
      "Verification ID already used"
    );
    usedVerifications.insert(disclose(verificationId));
  }

  // Generate a deterministic order ID
  const orderId = persistentHash<OrderIdInput>(OrderIdInput {
    traderHash: traderHash,
    assetId: assetId,
    price: price,
    amount: amount,
    timestamp: currentTime
  });

  // Ensure no duplicate order
  assert(!orders.member(disclose(orderId)), "Duplicate order ID");

  // Build the order
  const order = Order {
    orderId: orderId,
    traderHash: traderHash,
    orderType: orderType,
    assetId: assetId,
    price: price,
    amount: amount,
    filled: 0,
    status: OrderStatus.Open,
    timestamp: currentTime,
    verificationId: verificationId
  };

  orders.insert(disclose(orderId), disclose(order));
  totalOrders.increment(1);

  return disclose(orderId);
}

/**
 * Cancel an order.
 * Only the order's trader can cancel (must match traderHash).
 *
 * @param traderHash - Must match the order's traderHash
 * @param orderId - The order to cancel
 */
export circuit cancelOrder(
  traderHash: Bytes<32>,
  orderId: Bytes<32>
): [] {
  assert(orders.member(disclose(orderId)), "Order not found");
  const order = orders.lookup(disclose(orderId));
  assert(order.status == OrderStatus.Open, "Order is not open");
  assert(order.traderHash == traderHash, "Not the order trader");

  // Create cancelled copy
  const cancelledOrder = Order {
    orderId: order.orderId,
    traderHash: order.traderHash,
    orderType: order.orderType,
    assetId: order.assetId,
    price: order.price,
    amount: order.amount,
    filled: order.filled,
    status: OrderStatus.Cancelled,
    timestamp: order.timestamp,
    verificationId: order.verificationId
  };
  orders.insert(disclose(orderId), disclose(cancelledOrder));
}

/**
 * Fill a pair of matching orders.
 *
 * Called by a matcher/validator after off-chain price matching.
 * Compact has no loops, so batch fills are done per-pair from TypeScript.
 *
 * @param buyOrderId - The buy order to fill
 * @param sellOrderId - The sell order to fill
 * @param fillAmount - Amount to fill in this match
 */
export circuit fillOrders(
  buyOrderId: Bytes<32>,
  sellOrderId: Bytes<32>,
  fillAmount: Uint<64>
): [] {
  assert(fillAmount > 0, "Fill amount must be positive");

  // Load both orders
  assert(orders.member(disclose(buyOrderId)), "Buy order not found");
  assert(orders.member(disclose(sellOrderId)), "Sell order not found");

  const buyOrder = orders.lookup(disclose(buyOrderId));
  const sellOrder = orders.lookup(disclose(sellOrderId));

  // Validate orders
  assert(buyOrder.status == OrderStatus.Open, "Buy order is not open");
  assert(sellOrder.status == OrderStatus.Open, "Sell order is not open");
  assert(buyOrder.orderType == OrderType.Buy, "First order must be a buy");
  assert(sellOrder.orderType == OrderType.Sell, "Second order must be a sell");
  assert(buyOrder.assetId == sellOrder.assetId, "Asset ID mismatch");

  // Price compatibility: buy price >= sell price
  assert(buyOrder.price >= sellOrder.price, "Price mismatch: buy < sell");

  // Ensure fill doesn't exceed remaining amounts
  const buyRemaining = (buyOrder.amount - buyOrder.filled) as Uint<64>;
  const sellRemaining = (sellOrder.amount - sellOrder.filled) as Uint<64>;
  assert(fillAmount <= buyRemaining, "Fill exceeds buy order remaining");
  assert(fillAmount <= sellRemaining, "Fill exceeds sell order remaining");

  // Compute new filled amounts
  const newBuyFilled = (buyOrder.filled + fillAmount) as Uint<64>;
  const newSellFilled = (sellOrder.filled + fillAmount) as Uint<64>;

  // Determine new statuses
  const buyStatus = newBuyFilled == buyOrder.amount ? OrderStatus.Filled : OrderStatus.Open;
  const sellStatus = newSellFilled == sellOrder.amount ? OrderStatus.Filled : OrderStatus.Open;

  // Build updated orders
  const updatedBuy = Order {
    orderId: buyOrder.orderId,
    traderHash: buyOrder.traderHash,
    orderType: buyOrder.orderType,
    assetId: buyOrder.assetId,
    price: buyOrder.price,
    amount: buyOrder.amount,
    filled: newBuyFilled,
    status: buyStatus,
    timestamp: buyOrder.timestamp,
    verificationId: buyOrder.verificationId
  };
  const updatedSell = Order {
    orderId: sellOrder.orderId,
    traderHash: sellOrder.traderHash,
    orderType: sellOrder.orderType,
    assetId: sellOrder.assetId,
    price: sellOrder.price,
    amount: sellOrder.amount,
    filled: newSellFilled,
    status: sellStatus,
    timestamp: sellOrder.timestamp,
    verificationId: sellOrder.verificationId
  };

  orders.insert(disclose(buyOrderId), disclose(updatedBuy));
  orders.insert(disclose(sellOrderId), disclose(updatedSell));
}

/**
 * Get order details (public information only).
 *
 * @param orderId - The order to query
 * @returns OrderInfo struct with non-private fields
 */
export circuit getOrder(orderId: Bytes<32>): OrderInfo {
  assert(orders.member(disclose(orderId)), "Order does not exist");
  const order = orders.lookup(disclose(orderId));

  return OrderInfo {
    orderId: order.orderId,
    orderType: order.orderType,
    assetId: order.assetId,
    price: order.price,
    amount: order.amount,
    filled: order.filled,
    status: order.status,
    timestamp: order.timestamp
  };
}
