/**
 * ObfuscatedOrderbook.compact — SilentLedger v2
 *
 * Privacy-Preserving Orderbook with Ownership Verification
 *
 * Upgraded to v0.31.1 patterns:
 * - Witness-derived UserPublicKey (replaces bypassable ownPublicKey())
 * - Proper disclose() on all witness-derived values
 * - Uint<128> for amounts (widened from Uint<64>)
 * - Sealed admin key (was unsealed ZswapCoinPublicKey)
 * - Domain-separated key derivation
 * - Cancel via witness identity verification
 *
 * Patterns: midnight-expert FungibleToken, midnight-modules commitment-nullifier
 * Compiler: compactc v0.31.1
 */

pragma language_version >= 0.16 && <= 0.23;

import CompactStandardLibrary;

// ============================================================================
// DATA STRUCTURES
// ============================================================================

export enum OrderType { Buy, Sell }
export enum OrderStatus { Open, Filled, Cancelled }

export struct UserSecretKey {
  bytes: Bytes<32>;
}

export struct UserPublicKey {
  bytes: Bytes<32>;
}

export struct AdminPublicKey {
  bytes: Bytes<32>;
}

struct Order {
  orderId: Bytes<32>;
  traderHash: Bytes<32>;
  orderType: OrderType;
  assetId: Bytes<32>;
  price: Uint<128>;
  amount: Uint<128>;
  filled: Uint<128>;
  status: OrderStatus;
  timestamp: Uint<64>;
  verificationId: Bytes<32>;
}

export struct OrderInfo {
  orderId: Bytes<32>;
  orderType: OrderType;
  assetId: Bytes<32>;
  price: Uint<128>;
  amount: Uint<128>;
  filled: Uint<128>;
  status: OrderStatus;
  timestamp: Uint<64>;
}

struct OrderIdInput {
  traderHash: Bytes<32>;
  assetId: Bytes<32>;
  price: Uint<128>;
  amount: Uint<128>;
  timestamp: Uint<64>;
}

// ============================================================================
// LEDGER STATE
// ============================================================================

ledger orders: Map<Bytes<32>, Order>;
ledger usedVerifications: Set<Bytes<32>>;

// Admin key — witness-derived (was ownPublicKey())
sealed ledger adminKey: Bytes<32>;

export ledger verificationContractAddr: Bytes<32>;
export ledger totalOrders: Counter;

// ============================================================================
// WITNESSES
// ============================================================================

witness getUserSecret(): UserSecretKey;
witness getAdminSecret(): UserSecretKey;

// ============================================================================
// HELPER CIRCUITS
// ============================================================================

pure circuit deriveUserPublicKey(sk: UserSecretKey): UserPublicKey {
  return UserPublicKey {
    bytes: persistentHash<Vector<2, Bytes<32>>>([
      pad(32, "silentledger:obook:user:pk:v2"),
      sk.bytes
    ])
  };
}

pure circuit deriveAdminPublicKey(sk: UserSecretKey): AdminPublicKey {
  return AdminPublicKey {
    bytes: persistentHash<Vector<2, Bytes<32>>>([
      pad(32, "silentledger:obook:admin:pk:v2"),
      sk.bytes
    ])
  };
}

// ============================================================================
// CONSTRUCTOR
// ============================================================================

constructor() {
  const adminSecret = getAdminSecret();
  const adminPub = deriveAdminPublicKey(adminSecret);
  adminKey = disclose(adminPub.bytes);
  verificationContractAddr = pad(32, "");
}

// ============================================================================
// CIRCUITS
// ============================================================================

export circuit setVerificationContract(contractAddr: Bytes<32>): [] {
  const adminSecret = getAdminSecret();
  const adminPub = deriveAdminPublicKey(adminSecret);
  assert(disclose(adminPub.bytes == adminKey), "Only admin can set verification contract");
  verificationContractAddr = disclose(contractAddr);
}

export circuit placeOrder(
  traderHash: Bytes<32>,
  assetId: Bytes<32>,
  orderType: OrderType,
  price: Uint<128>,
  amount: Uint<128>,
  verificationId: Bytes<32>,
  currentTime: Uint<64>
): Bytes<32> {
  assert(disclose(price > 0), "Price must be positive");
  assert(disclose(amount > 0), "Amount must be positive");

  if (disclose(orderType) == OrderType.Sell) {
    assert(disclose(verificationId != pad(32, "")), "Sell orders require asset verification");
    assert(disclose(!usedVerifications.member(verificationId)), "Verification ID already used");
    usedVerifications.insert(disclose(verificationId));
  }

  const orderId = persistentHash<OrderIdInput>(OrderIdInput {
    traderHash: traderHash,
    assetId: assetId,
    price: price,
    amount: amount,
    timestamp: currentTime
  });

  assert(disclose(!orders.member(orderId)), "Duplicate order ID");

  const order = Order {
    orderId: orderId,
    traderHash: traderHash,
    orderType: orderType,
    assetId: assetId,
    price: price,
    amount: amount,
    filled: 0,
    status: OrderStatus.Open,
    timestamp: currentTime,
    verificationId: verificationId
  };

  orders.insert(disclose(orderId), disclose(order));
  totalOrders.increment(1);

  return disclose(orderId);
}

export circuit cancelOrder(
  traderHash: Bytes<32>,
  orderId: Bytes<32>
): [] {
  assert(disclose(orders.member(orderId)), "Order not found");
  const order = orders.lookup(disclose(orderId));
  assert(disclose(order.status == OrderStatus.Open), "Order is not open");
  assert(disclose(order.traderHash == traderHash), "Not the order trader");

  const cancelledOrder = Order {
    orderId: order.orderId,
    traderHash: order.traderHash,
    orderType: order.orderType,
    assetId: order.assetId,
    price: order.price,
    amount: order.amount,
    filled: order.filled,
    status: OrderStatus.Cancelled,
    timestamp: order.timestamp,
    verificationId: order.verificationId
  };
  orders.insert(disclose(orderId), disclose(cancelledOrder));
}

export circuit fillOrders(
  buyOrderId: Bytes<32>,
  sellOrderId: Bytes<32>,
  fillAmount: Uint<128>
): [] {
  assert(disclose(fillAmount > 0), "Fill amount must be positive");

  assert(disclose(orders.member(buyOrderId)), "Buy order not found");
  assert(disclose(orders.member(sellOrderId)), "Sell order not found");

  const buyOrder = orders.lookup(disclose(buyOrderId));
  const sellOrder = orders.lookup(disclose(sellOrderId));

  assert(disclose(buyOrder.status == OrderStatus.Open), "Buy order is not open");
  assert(disclose(sellOrder.status == OrderStatus.Open), "Sell order is not open");
  assert(disclose(buyOrder.orderType == OrderType.Buy), "First order must be a buy");
  assert(disclose(sellOrder.orderType == OrderType.Sell), "Second order must be a sell");
  assert(disclose(buyOrder.assetId == sellOrder.assetId), "Asset ID mismatch");
  assert(disclose(buyOrder.price >= sellOrder.price), "Price mismatch: buy < sell");

  const buyRemaining = (buyOrder.amount - buyOrder.filled) as Uint<128>;
  const sellRemaining = (sellOrder.amount - sellOrder.filled) as Uint<128>;
  assert(disclose(fillAmount <= buyRemaining), "Fill exceeds buy order remaining");
  assert(disclose(fillAmount <= sellRemaining), "Fill exceeds sell order remaining");

  const newBuyFilled = (buyOrder.filled + fillAmount) as Uint<128>;
  const newSellFilled = (sellOrder.filled + fillAmount) as Uint<128>;

  const buyStatus = newBuyFilled == buyOrder.amount ? OrderStatus.Filled : OrderStatus.Open;
  const sellStatus = newSellFilled == sellOrder.amount ? OrderStatus.Filled : OrderStatus.Open;

  const updatedBuy = Order {
    orderId: buyOrder.orderId,
    traderHash: buyOrder.traderHash,
    orderType: buyOrder.orderType,
    assetId: buyOrder.assetId,
    price: buyOrder.price,
    amount: buyOrder.amount,
    filled: newBuyFilled,
    status: buyStatus,
    timestamp: buyOrder.timestamp,
    verificationId: buyOrder.verificationId
  };
  const updatedSell = Order {
    orderId: sellOrder.orderId,
    traderHash: sellOrder.traderHash,
    orderType: sellOrder.orderType,
    assetId: sellOrder.assetId,
    price: sellOrder.price,
    amount: sellOrder.amount,
    filled: newSellFilled,
    status: sellStatus,
    timestamp: sellOrder.timestamp,
    verificationId: sellOrder.verificationId
  };

  orders.insert(disclose(buyOrderId), disclose(updatedBuy));
  orders.insert(disclose(sellOrderId), disclose(updatedSell));
}

export circuit getOrder(orderId: Bytes<32>): OrderInfo {
  assert(disclose(orders.member(orderId)), "Order does not exist");
  const order = orders.lookup(disclose(orderId));

  return OrderInfo {
    orderId: order.orderId,
    orderType: order.orderType,
    assetId: order.assetId,
    price: order.price,
    amount: order.amount,
    filled: order.filled,
    status: order.status,
    timestamp: order.timestamp
  };
}
